import glob

files = glob.glob("data/*.csv")

df_list = []

for file in files:
    df = pd.read_csv(file)
    df_list.append(df)

cyclistic_df = pd.concat(df_list, ignore_index=True)

# To preview rows and columns
cyclistic_df.head()
cyclistic_df.info()


# Data Cleaning (Convert date columns)
cyclistic_df['started_at'] = pd.to_datetime(cyclistic_df['started_at'])
cyclistic_df['ended_at'] = pd.to_datetime(cyclistic_df['ended_at'])

# Data Cleaning (Create ride length (minutes))
cyclistic_df['ride_length'] = (
    cyclistic_df['ended_at'] - cyclistic_df['started_at']
).dt.total_seconds() / 60

# Data Cleaning (Remove invalid rides)
cyclistic_df = cyclistic_df[cyclistic_df['ride_length'] > 0]

# To extract day, month, and hour from the start time to analyze ride patterns by weekday, season, and time of day.
cyclistic_df['day_of_week'] = cyclistic_df['started_at'].dt.day_name()
cyclistic_df['month'] = cyclistic_df['started_at'].dt.month_name()
cyclistic_df['hour'] = cyclistic_df['started_at'].dt.hour

# To count how many rides were taken by members versus casual users.
cyclistic_df['member_casual'].value_counts()

# To compare the average ride duration between members and casual riders.
cyclistic_df.groupby('member_casual')['ride_length'].mean()

# To compare the number of rides taken by members versus casual users.
sns.countplot(
    data=cyclistic_df,
    x='member_casual'
)
plt.title("Ride Count: Member vs Casual")
plt.show()

# To compare the average ride length between members and casual riders.
sns.barplot(
    data=cyclistic_df,
    x='member_casual',
    y='ride_length'
)
plt.title("Average Ride Length")
plt.show()

